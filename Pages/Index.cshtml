@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

@*Tech Hub Banner*@
<div class="row">
    <div class="col-sm-12">
        <div class="banner">
        </div>
    </div>
</div>

 @*Heading*@
<div class="row">
    <div class="col-sm-12">
        <div class="homepage1">
            <h1>Welcome to the offical Tech Hub Website!</h1>
            <p>
                Want to learn more about what the Tech Hub offers? You've come to the right place!
                Stop by BU084 to learn more about what we do here.
            </p>
        </div>
    </div>
</div>

@*Here I list some benefits of the tech hub in a row*@
<div class="row">
    <div class="col-sm-4">
        <div class="homepagebox">
            <h3>Collaboration Spaces</h3>
            <p>
                Anyone who stops by will be able to share ideas and work on projects with fellow students
            </p>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="homepagebox">
            <h3>Refuel for Success</h3>
            <p>
                The Tech Hub offfers a all sorts of snacks and drinks to give you enough energy to get your work done
            </p>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="homepagebox">
            <h3>Prepare for your Future</h3>
            <p>
                We offer a variety of opportunites to guide you toward the career of your dreams
            </p>
        </div>
    </div>
</div>

@*Here is where my carousel goes (4 images) along with an unordered bulleted list*@
<div class="row">
    <div class="col-sm-7 mt-3">
        <div id="HomepageCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#HomepageCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#HomepageCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#HomepageCarousel" data-bs-slide-to="2"></button>
                <button type="button" data-bs-target="#HomepageCarousel" data-bs-slide-to="3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/images/tech_hub_entrance.png" alt="Tech Hub Entrance" class="img-fluid" />
                </div>
                <div class="carousel-item">
                    <img src="~/images/collaboration1.png" alt="Image of a collaborative Space" class="img-fluid" />
                </div>
                <div class="carousel-item">
                    <img src="~/images/refuelstation.jpg" alt="Image of refuel station" class="img-fluid" />
                </div>
                <div class="carousel-item">
                    <img src="~/images/careeropportunities1.jpg" alt="Image of career opportunities" class="img-fluid" />
                </div>
            </div>

            <div>
                <button class="carousel-control-prev" type="button" data-bs-target="#HomepageCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#HomepageCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    </div>
    <div class="col-sm-5">
        <div class="bulletlist">
            <ul>
                <li>Learn great advice from industry experts</li>
                <li class="mt-2">Gain experience by working on real-world projects</li>
                <li class="mt-2">Network with students and professionals alike </li>
                <li class="mt-2">Get help fast with any of our student employees</li>
            </ul>
        </div>
    </div>
</div>

@*Tech Hub Stats via a dashboard*@
<div class="row">
    <div class="col-sm-12 mt-5">
        <div>
            <h2 class="text-center">Tech Hub Stats</h2>
            <p class="text-center">
                We're all about the numbers, and the numbers don't lie! Here is a dashboard to show our
                recorded stats concerning the activity at the Tech Hub.
            </p>
        </div>

        <div class="stats">
            <img src="~/images/dashboardwhitebg.png" alt="Image of Tech Hub Dashboard" class="img-fluid" />
        </div>
    </div>
</div>

@*Employer Attention*@
<div class="row">
    <div class="col-sm-12 text-center">
        <h3>Attention All Employers!</h3>
        <p>
            Looking to hire any students for internships or full time positions? Feel free to contact the Spears School of Business at 405-744-5064 or email us at 
            spearsinfo@okstate.edu.
            Feel free to also click the Spears Network link below to find students with the skills you need for your company.
        </p>
    </div>
</div>

@*Image of an interview*@
<div class="row">
    <div class="col-sm-12">
        <div class="col-sm-6 multipagebox w-100">
            <img src="~/images/interviewimage.jpg" alt="Image of an interview" class="img-fluid" />
        </div>
    </div>
</div>

@*Linked YoutTube Video about Spears School of Business, as well as an info blurb about Spears all in one row*@
<div class="row mt-5">
    <div class="col-sm-6">
        <h3>Learn More about Spears School of Business!</h3>
        @* 21:9 aspect ratio *@
        <div class="ratio ratio-21x9">
            @* place embed code from YouTube video inside this div *@
            <iframe width="560" height="315" src="https://www.youtube.com/embed/eTJMcBQg2gU?si=CFDkRHbrfH7W9RvZ" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
    </div>
    <div class="col-sm-6">
        <h3>What is Spears?</h3>
        <p>
            The Spears School of Business is a top-ranked business school that offers a wide range of programs and resources to help
            students succeed in their careers. From undergraduate to graduate programs, the Spears School of Business provides
            students with the knowledge and skills they need to excel in the business world.
        </p>
    </div>

</div>



