@page
@model RedmondJadenTheTechHub.Pages.Potential_CareersModel
@{
}

@*Heading*@
<div class="row">
    <div class="col-sm-12 text-center">
        <h1>Struggling to Find a Career or Internship?</h1>
        <p>
            Look no further...
        </p>
    </div>
</div>

@*Images of Career Fairs at the Tech Hub*@
<div class="row mt-5">
    <div class="col-sm-6">
        <div class="multipagebox">
            <img src="~/images/careerfairimage.jpg" alt="Career Fair Image" class="img-fluid" />
        </div>
    </div>

    <div class="col-sm-6">
        <div class="multipagebox">
            <img src="~/images/careerfairimage2.jpg" alt="Another career Fair Image" class="img-fluid" />
        </div>
    </div>


</div>

@*Heading #2*@
<div class="row">
    <div class="col-sm-12 mt-5">
        <h2>Forging your Future</h2>
        <p>
            Here at the Tech Hub, we partner with the best of the best to help students find a career that will enable them to put their hard earned skills to work.
            Feel free to take a look at what these companies have to offer by clicking on the "Find Opportunites" buttons.
        </p>
    </div>
</div>

@*6 bootstrap cards containing company information*@
<div class="row mt-1">
    <div class="col-sm-4">
        <div class="card h-100">
            <img src="~/images/continental.png" alt="Image of Continental Resources logo" class="card-img-top h-75" />
            <div class="card-body">
                <h5 class="card-title">Continental Resources</h5>
                <p class="card-text">An Oklahoma City-based independent oil and natural gas company founded by Harold Hamm. It focuses on producing in the Bakken region and in Oklahoma</p>
                <a href="https://www.clr.com/careers/" class="btn btn-outline-info" target="_blank">Find Opportunities</a>
            </div>
        </div>
    </div>

    <div class="col-sm-4">
        <div class="card h-100">
            <img src="~/images/loves.png" alt="Image of the Loves logo" class="card-img-top h-75" />
            <div class="card-body">
                <h5 class="card-title">Love's Corporate</h5>
                <p class="card-text">An Oklahoma City-based company that operates a large network of travel stops and country stores along highways across the U.S.</p>
                <a href="https://jobs.loves.com/" class="btn btn-outline-info" target="_blank">Find Opportunities</a>
            </div>
        </div>
    </div>

    <div class="col-sm-4">
        <div class="card h-100">
            <img src="~/images/expand1.png" alt="Image of the Expand Energy logo" class="card-img-top h-75" />
            <div class="card-body">
                <h5 class="card-title">Expand Energy</h5>
                <p class="card-text">Formed from the 2024 merger of Chesapeake Energy and Southwestern Energy, it is headquartered in Oklahoma City and is among the largest natural gas producers in the country</p>
                <a href="https://www.expandenergy.com/careers/" class="btn btn-outline-info" target="_blank">Find Opportunities</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-sm-4">
        <div class="card">
            <img src="~/images/midfirst.png" alt="Image of the MidFirst Bank Logo" class="card-img-top" />
            <div class="card-body">
                <h5 class="card-title">MidFirst Bank</h5>
                <p class="card-text">An Oklahoma City-based bank and one of the largest privately owned banks in the U.S offering personal and business resources</p>
                <a href="https://www.midfirst.com/careers/" class="btn btn-outline-info" target="_blank">Find Opportunities</a>
            </div>
        </div>
    </div>

    <div class="col-sm-4">
        <div class="card">
            <img src="~/images/conocophillips.png" alt="Image of the ConocoPhillips logo" class="card-img-top" />
            <div class="card-body">
                <h5 class="card-title">ConocoPhillips</h5>
                <p class="card-text">One of the world’s largest independent oil and natural gas exploration and production companies</p>
                <a href="https://www.conocophillips.com/careers/" class="btn btn-outline-info" target="_blank">Find Opportunities</a>
            </div>
        </div>
    </div>

    <div class="col-sm-4">
        <div class="card">
            <img src="~/images/caci.jpg" alt="Image of the CACI International logo" class="card-img-top" />
            <div class="card-body">
                <h5 class="card-title">CACI</h5>
                <p class="card-text">A technology and professional services company that supports U.S. defense, intelligence, and federal civilian agencies</p>
                <a href="https://searchcareers.caci.com/careers?start=0&pid=1443148808416&sort_by=relevance" class="btn btn-outline-info" target="_blank">Find Opportunities</a>
            </div>
        </div>
    </div>

</div>

