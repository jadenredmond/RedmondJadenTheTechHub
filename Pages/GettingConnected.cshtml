@page
@model RedmondJadenTheTechHub.Pages.Index1Model
@{
}

@*Heading*@
<div class="row">
    <div class="col-sm-12">
        <div class="text-center">
            <h1>Looking to Get Connnected with the Tech Hub Community?</h1>
            <p>
                Check out this page to learn more!
            </p>

        </div>
    </div>
</div>

@*Heading #2 (What to Expect)*@
<div class="row mt-5">
    <div class="col-sm-6">
        <h2>What to Expect</h2>
        <p>
            When you walk into BU085, you will see a check in desk near the front for people wanting
            to use any of the resources availble at your service. Once you get checked in, The people working there will be able to help with anything you need.

        </p>

    </div>

@*Heading #3 (Tutoring)*@
    <div class="col-sm-6">
        <h2>Tutoring</h2>
        <p>
            Neeed help with homework? Have a big exam coming up? Walk up to any table with a person who has a Tech Hub Tutor shirt and
            they will be able to help you out! They are always here to assist you.
        </p>
    </div>


</div>

@*Image of Front Desk at Tech Hub*@
<div class="row mt-3">
    <div class="col-sm-6">
        <div class="multipagebox">
            <img src="~/images/frontdesk.jpg" alt="Image of front desk" class="img-fluid" />
        </div>

    </div>

@*Image of Tech Hub Tutors*@
    <div class="col-sm-6">
        <div class="multipagebox">
            <img src="~/images/techhubtutors.jpg" alt="Image of Tech Hub Tutors helping others" class="img-fluid" />
        </div>

    </div>

</div>

@*Heading #4 (Commodities)*@
<div class="row mt-5">
    <div class="col-sm-12">
        <div class="text-center">
            <h2>Commodities</h2>
            <p>
                We provide a wide arange of snacks and drinks to give you an energy boost whenever you need it! Be sure to clean up after yourself and avoid crowding the area.
            </p>
        </div>
    </div>
</div>

@*Image of Refuel Station at Tech Hub*@
<div class="row mt-3">
    <div class="offset-1 col-sm-11">
        <div class="multipagebox">
            <img src="~/images/refuelstation.jpg" alt="Image of refuel station" class="img-fluid" />
        </div>
    </div>
</div>